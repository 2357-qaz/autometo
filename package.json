{
  "name": "automedo",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @automedo/web",
    "build": "npm run build -w @automedo/web",
    "preview": "npm run preview -w @automedo/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "server": "npm start -w @automedo/server",
    "server:dev": "npm run dev -w @automedo/server",
    "tui": "npm start -w @automedo/tui --",
    "audit:reproduce": "node --import tsx audit/reproduce.ts",
    "audit:test": "vitest run --config audit/vitest.config.ts",
    "audit:strict": "AUTOMEDO_AUDIT_STRICT=1 vitest run --config audit/vitest.config.ts",
    "audit:typecheck": "tsc -p audit"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
