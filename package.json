{
  "name": "automedo",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @automedo/web",
    "build": "npm run build -w @automedo/web",
    "preview": "npm run preview -w @automedo/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "server": "npm start -w @automedo/server",
    "server:dev": "npm run dev -w @automedo/server"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}